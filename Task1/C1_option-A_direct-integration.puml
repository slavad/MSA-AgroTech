@startuml C1_Option_A_Direct_Integration
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Платформа мониторинга свиноводческих ферм -- C1\nВариант A: прямая интеграция оборудования на ферме

Person(operator, "Оператор мониторинга", "Отслеживает алерты о поведении и здоровье животных")
Person(vet, "Зоотехник / ветеринар", "Анализирует отчеты о состоянии поголовья")
Person(duty, "Дежурный сотрудник фермы", "Получает локальные уведомления при отсутствии связи")
Person(lead, "Руководитель хозяйства", "Просматривает агрегированные показатели по фермам")

System(platform, "Платформа мониторинга свиноводческих ферм", "Центральный сервер + агенты на фермах: видеоаналитика, управление кормлением/поением, учет поголовья")

System_Ext(cameras, "Камеры видеонаблюдения", "Разные производители, прямой видеопоток на ферме")
System_Ext(feeders, "Кормушки и поилки", "Разные производители, прямое управление и телеметрия по открытым протоколам")
System_Ext(water, "Система фильтрации воды", "Телеметрия состояния фильтров")
System_Ext(corp, "Корпоративная платформа АгроТех Х", "Kafka / DWH / BI / ERP (1С:Агро) -- прием базовых метрик")
System_Ext(idp, "Система аутентификации", "SSO / IdP компании")
System_Ext(client, "Мобильное и веб-приложения", "Клиентские приложения на базе API платформы (вне скоупа MVP)")

Rel(operator, platform, "Отслеживает видео и алерты")
Rel(vet, platform, "Просматривает отчеты о состоянии животных")
Rel(duty, platform, "Получает офлайн-уведомления")
Rel(lead, platform, "Просматривает метрики")

Rel(cameras, platform, "Передают видеопоток", "RTSP/ONVIF")
Rel(platform, feeders, "Отправляет команды управления", "Modbus/MQTT")
Rel(feeders, platform, "Передают телеметрию", "Modbus/MQTT")
Rel(water, platform, "Передает телеметрию состояния фильтрации")

Rel(platform, corp, "Публикует базовые метрики", "REST/Kafka")
Rel(platform, idp, "Проверяет учетные данные пользователей", "OAuth2/OIDC")
Rel(client, platform, "Обращается к API", "REST/GraphQL")

SHOW_LEGEND()
@enduml
